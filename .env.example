# --- Meta Pixel (público, servido por /api/config) ---
# Só o ID numérico. Access token da Conversions API NÃO entra aqui:
# esse valor chega ao navegador.
META_PIXEL_ID=

# --- WhatsApp de atendimento (público) ---
# Formato internacional, só dígitos.
WHATSAPP_NUMBER=5551991580526
