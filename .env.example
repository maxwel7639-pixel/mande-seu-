# ==========================================================================
# Variáveis de ambiente — configurar no painel da Vercel
# (Project Settings > Environment Variables). NUNCA commitar valores reais.
# ==========================================================================

# --- Supabase (usado só no servidor, em /api/lead) ---
# URL do projeto MX Digital (ref ydbzqpkwfxybrdmadckm)
SUPABASE_URL=https://ydbzqpkwfxybrdmadckm.supabase.co
# service_role: ignora RLS e grava na funil_leads.
# NUNCA vai para o frontend. Só existe no ambiente do servidor.
